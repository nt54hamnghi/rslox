[
    {
        "label": "Build & Run",
        "build": {
            "command": "cargo",
            "args": ["build"],
        },
        "request": "launch",
        "program": "$ZED_WORKTREE_ROOT/target/debug/rslox",
        "args": ["run"],
        "adapter": "CodeLLDB",
        // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
        "sourceLanguages": ["rust"],
    },
]
