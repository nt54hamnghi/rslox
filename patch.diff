+    fn emit_opcode(&mut self, opcode: OpCode) {
+        self.emit_byte(opcode as u8);
+    }
+
+    fn emit_bytes(&mut self, bytes: impl IntoIterator<Item = u8>) {
+        for b in bytes {
+            self.emit_byte(b);
+        }
+    }
+
+    fn emit_constant(&mut self, value: Value) {
+        // bytecode is emitted only while compiling a previously consumed token,
+        // so `previous` is guaranteed to be `Some` here.
+        let line = self.previous.unwrap().line();
+        self.chunk.write_constant(value, line);
+    }
