+        // the scanner only produces NUMBER tokens for valid numeric literals
+        let value = lexeme.parse::<f64>().unwrap();
+        self.emit_constant(value);
+    }
+
+    fn next(&mut self) -> Option<Token> {
+        while let Some(Err(err)) = self.scanner.peek() {
+            eprintln!("{err}");
+            self.scanner.next();
+        }
+        // the loop skips errors, leaving an Ok token, so unwrapping is safe
+        self.scanner.next().transpose().unwrap()
+    }
+
+    fn peek(&mut self) -> Option<Token> {
+        while let Some(Err(err)) = self.scanner.peek() {
+            eprintln!("{err}");
+            self.scanner.next();
+        }
+        // the loop skips errors, leaving an Ok token, so unwrapping is safe
+        let Ok(token) = self.scanner.peek()? else {
