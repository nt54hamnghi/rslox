+impl<'source, 'chunk> Parser<'source, 'chunk> {
+    fn new(source: &'source str, chunk: &'chunk mut Chunk) -> Self {
+        let scanner = Scanner::new(source);
+        Self {
+            source,
+            scanner: scanner.peekable(),
