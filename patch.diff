+    fn parse_binding_power(&mut self, min_bp: u8) -> color_eyre::Result<()> {
+        let token = self.next().ok_or_eyre("unexpected end of token streams")?;
+        self.previous = Some(token);
+
+        // parsing lhs
+        match token.typ() {
+            TokenType::NUMBER => self.number(),
+            _ => todo!(),
+        };
+
+        loop {
+            let op = self.peek().ok_or_eyre("unexpected end of token streams")?;
+            let prec = match op.typ() {
+                TokenType::EOF => break,
+                _ => Precedence::from(op),
+            };
+            let (lbp, rbp) = prec.infix_binding_power();
+            if lbp < min_bp {
+                break;
+            }
+            // advance pass the operator
+            self.next().unwrap();
+            // parse rhs
+            self.parse_binding_power(rbp)?;
+        }
