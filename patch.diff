+
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+#[repr(u8)]
+enum Precedence {
+    NONE = 1,
+    ASSIGNMENT = 3,
+    OR = 5,
+    AND = 7,
+    EQUALITY = 9,
+    COMPARISON = 11,
+    TERM = 13,
+    FACTOR = 15,
+    UNARY = 17,
+    CALL = 19,
+    PRIMARY = 21,
+}
+
+impl Precedence {
+    fn prefix_binding_power(&self) -> ((), u8) {
+        match self {
+            Precedence::UNARY => {
+                let bp = *self as u8;
+                ((), bp)
+            }
+            _ => panic!("unknown prefix operator"),
+        }
+    }
+
+    fn infix_binding_power(&self) -> (u8, u8) {
+        match self {
+            Precedence::ASSIGNMENT | Precedence::TERM | Precedence::FACTOR => {
+                let bp = *self as u8;
+                (bp, bp + 1)
+            }
+            _ => panic!("unknown prefix operator"),
+        }
+    }
+}
+
+impl From<Token> for Precedence {
+    fn from(value: Token) -> Self {
+        match value.typ() {
+            TokenType::PLUS | TokenType::MINUS => Self::TERM,
+            TokenType::STAR | TokenType::SLASH => Self::FACTOR,
+            _ => Self::NONE,
+        }
+    }
+}
